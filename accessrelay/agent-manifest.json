{
    "brand":  "AccessRelay",
    "networks":  [
                     {
                         "name":  "accessrelay",
                         "front_man":  "access_coach",
                         "hocon":  "./accessrelay.network.json",
                         "description":  "Portable accessibility-coach agent network for other browser agentic sites.",
                         "tags":  [
                                      "agentified-website",
                                      "accessibility"
                                  ],
                         "sample_queries":  [
                                                "How do I associate labels with inputs?",
                                                "How should errors be announced by assistive technology?"
                                            ]
                     }
                 ],
    "llm_router":  {
                       "base_url":  "https://api.otari.ai/api/v1",
                       "mock":  false,
                       "byok_router":  "https://api.otari.ai/api/v1"
                   },
    "allowed_peers":  [

                      ],
    "peer_policy":  {
                        "mode":  "closed",
                        "deny_origins":  [

                                         ],
                        "note":  "Only known peer origins, with explicit visitor consent."
                    },
    "agent_mcp":  {
                      "protocol":  "nsdeploy-agent-mcp/v1",
                      "network":  "accessrelay",
                      "front_man":  "access_coach",
                      "available":  false,
                      "reason":  "Static hosting only; public MCP facade requires a host."
                  },
    "theme":  {
                  "primary":  "#2153a3"
              },
    "linking":  {
                    "protocol":  "nsdeploy-link/v1",
                    "exports":  [
                                    {
                                        "network":  "accessrelay",
                                        "front_man":  "access_coach",
                                        "aliases":  [
                                                        "accessrelay",
                                                        "access_coach"
                                                    ],
                                        "url":  "accessrelay"
                                    }
                                ],
                    "imports":  [

                                ],
                    "link_updates":  {
                                         "mode":  "browser-local"
                                     }
                },
    "deployment":  {
                       "mode":  "static",
                       "self_contained_runtime":  true,
                       "browser_mock":  false,
                       "direct_byok":  true,
                       "direct_mcp_requires_cors":  true,
                       "public_mcp_facade":  false
                   },
    "actions":  {
                    "version":  1,
                    "module":  "./site-actions.js",
                    "bridge":  "./bridge/action-bridge.html",
                    "agentTools":  [
                                       "get_public_guidance"
                                   ]
                }
}
