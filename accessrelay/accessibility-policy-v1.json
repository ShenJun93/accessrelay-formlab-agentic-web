{
  "protocol": "accessrelay-accessibility-policy/v1",
  "packId": "accessrelay-form-safety",
  "revision": "2026-11-18.1",
  "publisher": "AccessRelay demonstration maintainers (independent from W3C)",
  "scope": "Targeted FormLab demonstration only; not a WCAG conformance audit",
  "sources": [
    {
      "id": "WCAG-1.3.1",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/info-and-relationships"
    },
    {
      "id": "WCAG-3.3.1",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/error-identification"
    },
    {
      "id": "WCAG-1.4.3",
      "url": "https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum"
    }
  ],
  "rules": [
    {
      "issueId": "associate_label",
      "ruleId": "form-label-for/v1",
      "reasonCode": "label_not_associated",
      "sourceId": "WCAG-1.3.1",
      "condition": "visible_label_unassociated",
      "decisionWhenMet": "recommend",
      "fallback": "hold"
    },
    {
      "issueId": "announce_errors",
      "ruleId": "form-error-announcement/v1",
      "reasonCode": "validation_error_not_announced",
      "sourceId": "WCAG-3.3.1",
      "condition": "visible_validation_error_unannounced",
      "decisionWhenMet": "recommend",
      "fallback": "hold"
    },
    {
      "issueId": "increase_contrast",
      "ruleId": "form-helper-contrast/v1",
      "reasonCode": "helper_text_low_contrast",
      "sourceId": "WCAG-1.4.3",
      "condition": "computed_contrast_below_threshold",
      "contrastThreshold": 4.5,
      "decisionWhenMet": "recommend",
      "fallback": "hold"
    }
  ]
}
